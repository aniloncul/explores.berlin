<mjml>
  <mj-head>
    <mj-title>Explores Berlin - Weekly Rave Guide</mj-title>
    <mj-font name="Goldman" href="https://fonts.googleapis.com/css2?family=Goldman:wght@400;700&display=swap" />
    <mj-attributes>
      <mj-all font-family="Goldman, sans-serif" padding="0px"></mj-all>
      <mj-text font-weight="400" font-size="14px" color="#ffffff" line-height="24px"></mj-text>
      <mj-button background-color="#ffffff" color="#000000" font-weight="bold" text-transform="uppercase"></mj-button>
      <mj-class name="link-text" color="#aaaaaa" text-decoration="none" font-weight="bold" />
    </mj-attributes>
    <mj-style>
      .title-text { text-transform: uppercase; letter-spacing: 4px; }
      .highlight-img img { border: 2px solid #ff0033; box-shadow: 0 0 15px rgba(255, 0, 51, 0.5); }
      .hover-scale:hover { opacity: 0.8; }
      a { color: #ff0033; text-decoration: none; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#050505">
    
    <!-- 1. BIG HEADER ON TOP -->
    <mj-section padding="40px 0 20px 0" background-color="#000000">
      <mj-column>
        <mj-text align="center" font-size="52px" font-weight="700" color="#ffffff" css-class="title-text" line-height="1">
          Explores Berlın
        </mj-text>
     

      </mj-column>
    </mj-section>

    <!-- Navigation / Links (Optional, matching style) -->
    <mj-section padding="10px 0 40px 0" background-color="#000000">
      <mj-column>
        <mj-text align="center" font-size="12px" letter-spacing="2px">
          <a href="#" style="color:#fff; margin:0 10px;">EVENTS</a> |
          <a href="#" style="color:#fff; margin:0 10px;">FOOD</a> |
          <a href="#" style="color:#fff; margin:0 10px;">EXHIBITIONS</a> |
          <a href="#" style="color:#fff; margin:0 10px;">CULTURE</a>
        </mj-text>
      </mj-column>
    </mj-section>
    
    <!-- 2. RECAP SECTION (Title + Paragraph) -->
    <mj-section background-color="#0a0a0a" padding="40px 20px">
      <!-- Editor Image/Avatar column -->
      <mj-column width="25%">
         <mj-image width="80px" border-radius="50%" src="https://explores-berlin.vercel.app/nazli.jpg" alt="Editor"></mj-image>
         <mj-text align="center" font-size="12px" color="#666" padding-top="10px">
           NAZLI<br>
      
         </mj-text>
      </mj-column>
      
      <!-- Text Column -->
      <mj-column width="75%">
        <mj-text font-size="24px" font-weight="700" color="#ffffff" text-transform="uppercase" padding-bottom="15px">
           WEEK 04: INTO THE DUST
        </mj-text>
        <mj-text color="#cccccc" font-size="14px">
          The winter fog has settled over the Spree, but the basements are hotter than ever. This week, we saw the closure of a beloved Neukölln spot, but two new industrial spaces just opened in Marzahn. Whether you're looking for hard groove or hypnotic loops, the city is providing.
        </mj-text>
        <mj-text color="#cccccc" font-size="14px" padding-top="10px">
          This weekend is special. We have a rare b2b set at RSO and a 36-hour marathon kicking off Friday. Check the full guide below.
        </mj-text>
        <mj-text padding-top="15px">
           <a href="#" style="font-weight:bold; border-bottom:1px solid #ff0033;">READ FULL EDITORIAL &rarr;</a>
        </mj-text>
      </mj-column>
    </mj-section>

   <!-- SECTION DIVIDER -->
    <mj-section padding="0">
        <mj-column>
             <mj-divider border-color="#222" border-width="1px"></mj-divider>
        </mj-column>
    </mj-section>

    <!-- 3. HIGHLIGHT: WEEKEND GUIDE SECTION -->
    <mj-section padding="40px 20px 10px 20px">
        <mj-column>
            <mj-text color="#ff0033" font-weight="bold" font-size="14px" letter-spacing="1px" padding-bottom="20px" text-transform="uppercase">
                Don't Miss This
            </mj-text>
        </mj-column>
    </mj-section>

    <mj-section padding="0 20px 40px 20px">
      <mj-column>
        <!-- Highlight Image with Glow/Border -->
        <mj-image 
            src="https://explores-berlin.vercel.app/newsletter/2026_W05/weekend_guide.png" 
            alt="Weekend Guide Highlight" 
            href="https://www.instagram.com/p/DTyY3HjiGRm/?img_index=1"
            css-class="highlight-img"
            border-radius="4px"
        ></mj-image>
        
        <mj-text align="left" font-size="28px" font-weight="700" padding-top="20px" text-transform="uppercase">
          <a href="https://www.instagram.com/p/DTyY3HjiGRm/?img_index=1" style="color:#fff; text-decoration:none;">
            The Ultimate Weekend Guide: Jan 23-25
          </a>
        </mj-text>
        <mj-text color="#888" padding-top="10px">
            Your comprehensive list of every open floor, timetable, and door policy for the upcoming 72 hours.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 4. EVENTS GRID (As photos + titles) -->
    <mj-section padding="20px 20px 10px 20px" background-color="#080808">
        <mj-column>
             <mj-text color="#ff0033" font-weight="bold" font-size="14px" letter-spacing="1px" padding-bottom="10px" text-transform="uppercase">
                Weekly Recap
            </mj-text>
        </mj-column>
    </mj-section>

    <mj-section padding="0 10px 40px 10px" background-color="#080808">
      <!-- Event 1 -->
      <mj-column width="50%" padding="10px">
        <mj-image 
            src="https://explores-berlin.vercel.app/newsletter/2026_W05/Event-1.png" 
            alt="Event 1"
            href="https://www.instagram.com/p/DT8bvQ9CCod/"
            height="200px"
            object-fit="cover"
            border-radius="4px"
        ></mj-image>
        <mj-text font-size="16px" font-weight="bold" padding-top="15px">
           <a href="#" style="color:#ffffff;">Wesserstraße: Berlin's Iconic Street to Go Out </a>
        </mj-text>
        <mj-text color="#666" font-size="12px" padding-top="5px">
            
        </mj-text>
      </mj-column>

      <!-- Event 2 -->
      <mj-column width="50%" padding="10px">
        <mj-image 
            src="https://explores-berlin.vercel.app/newsletter/2026_W05/Event-2.png" 
            alt="Event 2"
            href="https://www.instagram.com/p/DTtdR7FCOA3/"
            height="200px"
            object-fit="cover"
            border-radius="4px"
        ></mj-image>
        <mj-text font-size="16px" font-weight="bold" padding-top="15px">
           <a href="#" style="color:#ffffff;">Northen Lights of Berlin</a>
        </mj-text>
         <mj-text color="#666" font-size="12px" padding-top="5px">
            Saturday, 23:59
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#000000" padding="40px 20px" border-top="1px solid #222">
      <mj-column>
        <mj-text align="center" color="#444444" font-size="10px" text-transform="uppercase" font-family="monospace">
          © 2026 Explores Berlin<br><br>
          <a href="{{{ unsubscribe }}}" style="color:#666; text-decoration:none;">Unsubscribe</a> &nbsp;|&nbsp; <a href="{{{ mirror }}}" style="color:#666; text-decoration:none;">View in Browser</a> &nbsp;|&nbsp; <a href="https://explores-berlin.vercel.app/impressum" style="color:#666; text-decoration:none;">Impressum</a>
        </mj-text>
      </mj-column>
    </mj-section>
    
  </mj-body>
</mjml>
